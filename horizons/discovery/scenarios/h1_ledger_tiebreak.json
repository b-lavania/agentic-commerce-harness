{
  "id": "h1_ledger_tiebreak",
  "horizon": "h1",
  "description": "On-prem standard with a spare. minimize_recurring selects fk-mini at 38000, not the first row.",
  "catalog": "horizons/discovery/catalog/v1.json",
  "max_macro_steps": 40,
  "task": {
    "intent": "office laptop standard spare",
    "constraints": { "deployment": "on_prem", "perf": "standard", "spare": "required" },
    "preferences": [{ "minimize_recurring": true }]
  },
  "steps": [
    { "action": "search", "body": { "q": "office laptop standard spare" } },
    {
      "action": "set_facets",
      "body": { "deployment": "on_prem", "perf": "standard", "spare": "required" }
    },
    {
      "action": "compare",
      "body": { "ids": ["nl-14", "hb-16", "fk-mini"] }
    },
    {
      "action": "commit_shortlist",
      "body": { "ids": ["fk-mini"] }
    },
    {
      "action": "save_shortlist",
      "body": { "ids": ["fk-mini"] }
    },
    { "action": "compose_quote", "body": {}, "expect": { "ok": true } }
  ],
  "expect": {
    "shortlist_passes_oracle": true,
    "milestones": ["facets_applied", "compared", "shortlist_saved"],
    "constraints": {
      "deployment": "on_prem",
      "perf": "standard",
      "spare": "required"
    },
    "forbidden_actions": ["checkout", "set_amount"]
  }
}
