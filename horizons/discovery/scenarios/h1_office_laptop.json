{
  "id": "h1_office_laptop",
  "horizon": "h1",
  "description": "Office buyer: standard laptop with a spare → compare three machines → desk care → shortlist",
  "catalog": "horizons/discovery/catalog/v1.json",
  "max_macro_steps": 40,
  "steps": [
    { "action": "search", "body": { "q": "office laptop standard spare" } },
    {
      "action": "set_facets",
      "body": { "deployment": "on_prem", "perf": "standard", "spare": "required" }
    },
    {
      "action": "compare",
      "body": { "ids": ["nl-14", "hb-16", "fk-mini"] }
    },
    { "action": "list_addons", "body": { "appliance_id": "nl-14" } },
    { "action": "attach_addon", "body": { "service_id": "care-desk" } },
    {
      "action": "save_shortlist",
      "body": { "ids": ["nl-14", "hb-16", "fk-mini", "care-desk"] }
    },
    {
      "action": "commit_shortlist",
      "body": { "ids": ["nl-14", "care-desk"] }
    },
    { "action": "compose_quote", "body": {}, "expect": { "ok": true } }
  ],
  "expect": {
    "shortlist_passes_oracle": true,
    "milestones": ["facets_applied", "compared", "addon_in_path", "shortlist_saved"],
    "constraints": {
      "deployment": "on_prem",
      "perf": "standard",
      "spare": "required"
    },
    "forbidden_actions": ["checkout", "set_amount"]
  }
}
