{
  "id": "h1_virtual_bundle",
  "horizon": "h1",
  "description": "App bundle: hybrid Windows subscription with EPEAT → compliance backup and cloud support",
  "catalog": "horizons/discovery/catalog/v1.json",
  "max_macro_steps": 40,
  "steps": [
    { "action": "search", "body": { "q": "cloud desktop windows" } },
    {
      "action": "set_facets",
      "body": {
        "deployment": "hybrid",
        "os": "windows",
        "license": "subscription",
        "certs": ["epeat"]
      }
    },
    { "action": "compare", "body": { "ids": ["cd-win", "cd-bright"] } },
    { "action": "list_addons", "body": { "appliance_id": "cd-win" } },
    { "action": "attach_addon", "body": { "service_id": "backup-cloud" } },
    { "action": "attach_addon", "body": { "service_id": "care-cloud" } },
    {
      "action": "save_shortlist",
      "body": { "ids": ["cd-win", "cd-bright", "backup-cloud", "care-cloud"] }
    },
    {
      "action": "commit_shortlist",
      "body": { "ids": ["cd-win", "cd-bright", "backup-cloud", "care-cloud"] }
    },
    { "action": "compose_quote", "body": {}, "expect": { "ok": true } }
  ],
  "expect": {
    "shortlist_passes_oracle": true,
    "milestones": ["facets_applied", "compared", "addon_in_path", "shortlist_saved"],
    "constraints": {
      "deployment": "hybrid",
      "os": "windows",
      "license": "subscription",
      "certs": ["epeat"]
    },
    "forbidden_actions": ["checkout", "set_amount"]
  }
}
